; Ouche City — projet Godot.
; Version du moteur figée : 4.4.1-stable (décision docs/decisions/0001-version-godot.md).
; Ne pas modifier sans décision de l'orchestrateur.

config_version=5

[application]

config/name="Ouche City"
config/description="Open-world d'action-aventure en cel-shading à Conches-en-Ouche."
config/version="0.1.0-m0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")
config/icon="res://icon.svg"
config/macos_native_icon=""
config/windows_native_icon=""

[autoload]

Settings="*res://scripts/core/settings.gd"
Net="*res://scripts/net/network_manager.gd"
Sfx="*res://scripts/audio/sfx.gd"
Progress="*res://scripts/core/progress.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/dpi/allow_hidpi=true

[gui]

theme/default_font_multichannel_signed_distance_field=true

[input]

