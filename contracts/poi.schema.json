{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ouche-city/contracts/poi.schema.json",
  "title": "Points d'intérêt Ouche City",
  "description": "Lieux nommés du jeu : produits par gis/ (lieux réels anonymisés) et complétés par level-designer (lieux de mission). Tous les commerces sont fictifs.",
  "version": 1,
  "type": "object",
  "required": ["schemaVersion", "pois"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "pois": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "label", "position"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "kind": { "type": "string", "enum": ["landmark", "shop", "hideout", "mission_start", "mission_target", "spawn", "viewpoint", "service"] },
          "label": { "type": "string", "description": "Nom affiché, fictif pour tout commerce." },
          "position": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
          "tile": { "type": "string", "pattern": "^-?[0-9]+_-?[0-9]+$" },
          "radius": { "type": "number", "minimum": 0 },
          "missions": { "type": "array", "items": { "type": "string", "pattern": "^m[0-9]{2}_[a-z0-9_]+$" } },
          "source": { "type": "string", "enum": ["osm", "ign", "design"] }
        }
      }
    }
  }
}
