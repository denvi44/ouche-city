{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frouch-city/contracts/road_graph.schema.json",
  "title": "Graphe routier Frouch City",
  "description": "Graphe de navigation et de trafic produit par gis/ (agent 01) pour l'agent 06. Repère local identique aux tuiles (x est, z sud, mètres).",
  "version": 1,
  "type": "object",
  "required": ["schemaVersion", "nodes", "edges", "attribution"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodes": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "position"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^n_-?[0-9]+$" },
          "position": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "from", "to", "kind", "oneway", "lengthM", "speedKmh", "width", "points"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "from": { "type": "string" },
          "to": { "type": "string" },
          "kind": { "type": "string", "enum": ["primary", "secondary", "tertiary", "residential", "service", "pedestrian", "footway", "track"] },
          "name": { "type": ["string", "null"] },
          "oneway": { "type": "boolean" },
          "lengthM": { "type": "number", "minimum": 0 },
          "speedKmh": { "type": "number", "minimum": 0 },
          "width": { "type": "number", "exclusiveMinimum": 0 },
          "points": { "type": "array", "minItems": 2 }
        }
      }
    },
    "attribution": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  }
}
