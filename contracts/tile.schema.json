{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://frouch-city/contracts/tile.schema.json",
  "title": "Tuile de ville Frouch City",
  "description": "Une tuile carrée de 250 m produite par gis/ (agent 01), consommée par blender/ et game/. Coordonnées locales en mètres : x vers l'est, z vers le sud (convention Godot), origine = coin nord-ouest de l'emprise globale. v2 : arbres [x, z] ou [x, z, espèce] (0 feuillu, 1 pin, 2 pommier, 3 peuplier) ; végétation « orchard » (verger).",
  "version": 2,
  "type": "object",
  "required": [
    "schemaVersion",
    "tile",
    "origin",
    "size",
    "buildings",
    "roads",
    "vegetation",
    "attribution"
  ],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tile": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "integer"
        },
        "y": {
          "type": "integer"
        }
      }
    },
    "origin": {
      "$ref": "#/$defs/vec2",
      "description": "Coin nord-ouest de la tuile en coordonnées locales globales (m)."
    },
    "size": {
      "type": "number",
      "const": 250
    },
    "scale": {
      "type": "number",
      "enum": [
        1,
        0.5
      ],
      "default": 1,
      "description": "1 = 1:1 (centre médiéval), 0.5 = compression 1:2 (périphérie)."
    },
    "ground": {
      "type": "object",
      "description": "Relief : grille régulière d'altitudes relatives (m) sur la tuile, ligne par ligne du nord au sud.",
      "required": [
        "resolution",
        "heights"
      ],
      "additionalProperties": false,
      "properties": {
        "resolution": {
          "type": "integer",
          "minimum": 2
        },
        "baseAltitude": {
          "type": "number"
        },
        "heights": {
          "type": "array",
          "items": {
            "type": "number"
          }
        }
      }
    },
    "buildings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "footprint",
          "height",
          "typology"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^b_[0-9a-z_]+$"
          },
          "footprint": {
            "$ref": "#/$defs/ring"
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 80
          },
          "levels": {
            "type": "integer",
            "minimum": 1
          },
          "roof": {
            "type": "string",
            "enum": [
              "flat",
              "gabled",
              "hipped",
              "spire"
            ]
          },
          "typology": {
            "type": "string",
            "enum": [
              "colombages",
              "brique",
              "pavillon",
              "commerce",
              "public",
              "eglise",
              "annexe"
            ]
          },
          "groundZ": {
            "type": "number"
          }
        }
      }
    },
    "roads": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "points",
          "width"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Nom réel de la rue (conservé), jamais de nom de commerce ou de particulier."
          },
          "kind": {
            "type": "string",
            "enum": [
              "primary",
              "secondary",
              "tertiary",
              "residential",
              "service",
              "pedestrian",
              "footway",
              "track"
            ]
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "$ref": "#/$defs/vec2"
            }
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "sidewalk": {
            "type": "number",
            "minimum": 0,
            "description": "Largeur de chaque trottoir (m), 0 si aucun."
          },
          "oneway": {
            "type": "boolean"
          },
          "surface": {
            "type": "string",
            "enum": [
              "asphalt",
              "pavers",
              "gravel",
              "grass"
            ]
          }
        }
      }
    },
    "vegetation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "polygon"
        ],
        "additionalProperties": false,
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "grass",
              "park",
              "forest",
              "garden",
              "farmland",
              "water",
              "orchard"
            ]
          },
          "polygon": {
            "$ref": "#/$defs/ring"
          }
        }
      }
    },
    "trees": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 3
      }
    },
    "attribution": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "vec2": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/vec2"
      },
      "description": "Polygone fermé implicitement, sens antihoraire vu du dessus, sans répétition du premier point."
    }
  }
}
